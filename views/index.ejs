<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PictoPost</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
</head>

<body>
  <nav class="navbar navbar-dark bg-dark shadow-sm">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="#" class="navbar-brand d-flex align-items-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor"
          stroke-linecap="round" stroke-linejoin="round" stroke-width="2" aria-hidden="true" class="me-2"
          viewBox="0 0 24 24">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
          <circle cx="12" cy="13" r="4"></circle>
        </svg>
        <strong>PictoPost</strong>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarHeader"
        aria-controls="navbarHeader" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
  </nav>

  <div class="collapse bg-dark text-white" id="navbarHeader">
    <div class="container py-4">
      <div class="row">
        <div class="col-sm-8 col-md-7">
          <h4>About</h4>
          <p>PictoPost is a vibrant social platform where you can effortlessly share your moments through images and
            text. Connect, inspire, and express yourself with a community that celebrates creativity and storytelling.
          </p>
        </div>
        <div class="col-sm-4 offset-md-1">
          <h4>Contact</h4>
          <ul class="list-unstyled">
            <li><a href="#" class="text-white">Follow on X</a></li>
            <li><a href="#" class="text-white">Like on Facebook</a></li>
            <li><a href="#" class="text-white">Email me</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Your page main content starts here -->
  <section class="text-center py-5 container ">
    <h1 class="fw-light">PictoPost posts</h1>
    <p class="lead text-body-secondary mb-4">PictoPost is a vibrant social platform where you can effortlessly share
      your moments through images and text. Connect, inspire, and express yourself with a community that celebrates
      creativity and storytelling.</p>
    <div>
      <a href="/posts/new" class="btn btn-primary me-2">
        Add new post
      </a>

      <a href="#posts" class="btn btn-secondary">
        See post
      </a>
    </div>

  </section>
  <hr>

  <div class="container mb-5 text-center" id="posts">
    <div class="row row-cols-1 row-cols-md-3 g-4">
      <% posts.forEach(function(post) { %>
        <div class="col">
          <div class="card" style="width: 24rem; margin: auto;">
            <img src="<%= post.url %>" class="card-img-top" alt="Post Image">

            <div class="card-body">
              <h5 class="card-title">
                <%= post.username %>
              </h5>
              <h6 class="card-subtitle mb-2 fst-italic text-body-secondary">@<%= post.username.toLowerCase() %>
              </h6>
              <p class="card-text">
                <%= post.context %>
              </p>

              <div class="d-flex justify-content-between mb-2">
                <a href="/posts/<%= post.id %>">
                  <button type="button" class="btn btn-primary flex-fill me-2">View</button>
                </a>
                <a href="/posts/<%= post.id %>/edit">
                  <button type="button" class="btn btn-success flex-fill me-2">Edit</button>
                </a>
                <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" class="flex-fill m-0">
                  <button type="submit" class="btn btn-danger w-100">Delete</button>
                </form>
              </div>

            </div>
          </div>
        </div>
        <% }) %>
    </div>


  </div>

<footer class="text-white py-5 bg-dark mt-auto">
  <div class="container">
    <p class="float-end mb-1">
      <a href="/posts" class="text-white">Back to top</a>
    </p>
    <p class="mb-1">© 2025 PictoPost. All rights reserved.</p>
    <p class="mb-0">
      New to PictoPost? <a href="/posts/new" class="text-white text-decoration-underline">Create your first post</a> or read our
      <a href="index.md" class="text-white text-decoration-underline">Getting Started Guide</a>.
    </p>
  </div>
</footer>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
    crossorigin="anonymous"></script>
</body>

</html>